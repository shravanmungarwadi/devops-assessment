# Copy this file to .env before running docker compose.
#   cp .env.example .env
#
# .env is git-ignored on purpose - never commit real credentials.

POSTGRES_DB=hotelbook
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432

# Name of the running Postgres service/container, used by the backup and
# restore scripts to target the right container.
DB_SERVICE_NAME=db
